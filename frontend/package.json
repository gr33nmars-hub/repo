{
  "name": "noir-casino-club",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "node ./scripts/dev-desktop.mjs",
    "tauri": "node ./scripts/tauri.mjs",
    "tauri:dev": "npm run tauri -- dev",
    "build:desktop": "npm run build && uv run --directory .. --group build pyinstaller --noconfirm --clean --onefile --noconsole --name astoria-api-x86_64-pc-windows-msvc --paths backend --distpath frontend/src-tauri/binaries --workpath frontend/build/pyinstaller backend/run_api.py",
    "tauri:build": "npm run tauri -- build",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:unit": "node --test tests/*.test.mjs",
    "smoke:sidecar": "node scripts/smoke-sidecar.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
